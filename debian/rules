#!/usr/bin/make -f
# -*- makefile -*-

include /usr/share/dpkg/architecture.mk

export DH_VERBOSE=1
export CARGO_HOME=$(CURDIR)/target/cargo
export RUSTUP_TOOLCHAIN=stable
export PATH:=$(HOME)/.cargo/bin:$(PATH)

%:
	dh $@

override_dh_auto_clean:
	# Do not erase the cargo cache: preserves incremental compilation.
	# In CI, crates/target is absent anyway (clean clone).
	true

override_dh_clean:
	# dh_clean's default cruft-removal (part of every `debian/rules clean`,
	# which dpkg-buildpackage always runs before building — including on
	# the Launchpad builder itself, unconditionally) deletes any *.orig
	# file anywhere in the tree, meant for stray patch-reject leftovers.
	# It doesn't know vendor/*/Cargo.toml.orig are files cargo actually
	# needs at build time to verify a vendored crate's checksum — without
	# this exclude, they get wiped right before override_dh_auto_build
	# runs, even though they were present in the uploaded source tarball.
	dh_clean -Xvendor

override_dh_auto_build:
	# If vendor/ + the vendoring block in .cargo/config.toml are present
	# (see debian/scripts/prepare-offline-build.sh), build fully offline —
	# this is what a Launchpad PPA build needs, since its builders have no
	# general internet access to reach crates.io. Otherwise (GitHub
	# Actions, local dev), fall back to the normal networked build.
	#
	# qbz-qt goes through scripts/qt-cargo.py, never a raw `cargo build`:
	# it fingerprints the Qt SDK's headers into CXXFLAGS so an in-place Qt
	# update can't leave cxx-qt-lib built against stale inline templates
	# (see that script's own docstring — this caused a real startup
	# SIGSEGV upstream, #549-adjacent). QMAKE points at the apt-installed
	# qt6-base-dev-tools binary; resolute ships Qt 6.10, comfortably above
	# the >= 6.8 floor QtQuick.Effects and Image.retainWhileLoading need
	# (Ubuntu 24.04 LTS is stuck at 6.4.2 — this is exactly why this
	# packaging targets resolute/25.04+ only, not the LTS).
	if grep -q '^\[source\.vendored-sources\]' $(CURDIR)/.cargo/config.toml 2>/dev/null; then \
		OFFLINE="--offline"; \
		find $(CURDIR)/vendor -type f -name '*.dpkg-source-workaround' | \
			while IFS= read -r f; do mv "$$f" "$${f%.dpkg-source-workaround}"; done; \
	else \
		OFFLINE=""; \
	fi; \
	QMAKE=/usr/bin/qmake6 python3 scripts/qt-cargo.py build --release --locked $$OFFLINE \
		--manifest-path crates/Cargo.toml -p qbz-qt; \
	cargo build --release --locked $$OFFLINE --manifest-path crates/Cargo.toml -p qbzd

override_dh_auto_test:
	# The full workspace's test suite (40+ crates, several hitting real
	# audio/CD-ROM/D-Bus fixtures) is not something to run unattended on a
	# shared Launchpad builder — skip it here, same call linux-hello made
	# for its own hardware-dependent tests. CI (test-crates.yml) is the
	# real gate.
	echo "Skipping automated tests (see test-crates.yml for the real gate)"

override_dh_auto_install:
	mkdir -p $(CURDIR)/debian/tmp/usr/bin
	cp $(CURDIR)/crates/target/release/qbz $(CURDIR)/debian/tmp/usr/bin/
	cp $(CURDIR)/crates/target/release/qbzd $(CURDIR)/debian/tmp/usr/bin/

	mkdir -p $(CURDIR)/debian/tmp/usr/lib/systemd/user
	cp $(CURDIR)/crates/qbzd/service/qbzd.service $(CURDIR)/debian/tmp/usr/lib/systemd/user/

	mkdir -p $(CURDIR)/debian/tmp/usr/share/applications
	cp $(CURDIR)/packaging/linux/qbz.desktop \
	   $(CURDIR)/debian/tmp/usr/share/applications/com.blitzfc.qbz.desktop

	mkdir -p $(CURDIR)/debian/tmp/usr/share/metainfo
	cp $(CURDIR)/packaging/flatpak/com.blitzfc.qbz.metainfo.xml \
	   $(CURDIR)/debian/tmp/usr/share/metainfo/

	for size in 32 48 64 128 256 512; do \
		mkdir -p $(CURDIR)/debian/tmp/usr/share/icons/hicolor/$${size}x$${size}/apps; \
		cp $(CURDIR)/packaging/icons/$${size}x$${size}.png \
		   $(CURDIR)/debian/tmp/usr/share/icons/hicolor/$${size}x$${size}/apps/qbz.png; \
	done

	mkdir -p $(CURDIR)/debian/tmp/usr/share/doc/qbzd
	cp $(CURDIR)/packaging/linux/qbzd-standalone-README.md \
	   $(CURDIR)/debian/tmp/usr/share/doc/qbzd/README.md

	mkdir -p $(CURDIR)/debian/tmp/usr/share/doc/qbz/third-party \
	         $(CURDIR)/debian/tmp/usr/share/doc/qbzd/third-party
	cp $(CURDIR)/licenses/* $(CURDIR)/debian/tmp/usr/share/doc/qbz/third-party/
	cp $(CURDIR)/licenses/* $(CURDIR)/debian/tmp/usr/share/doc/qbzd/third-party/

	# Shell completions: generated by the freshly built qbzd binary itself
	# (same approach as the AUR qbzd package) rather than hand-maintained.
	mkdir -p $(CURDIR)/debian/tmp/usr/share/bash-completion/completions \
	         $(CURDIR)/debian/tmp/usr/share/zsh/site-functions \
	         $(CURDIR)/debian/tmp/usr/share/fish/vendor_completions.d
	$(CURDIR)/debian/tmp/usr/bin/qbzd completions bash \
		> $(CURDIR)/debian/tmp/usr/share/bash-completion/completions/qbzd
	$(CURDIR)/debian/tmp/usr/bin/qbzd completions zsh \
		> $(CURDIR)/debian/tmp/usr/share/zsh/site-functions/_qbzd
	$(CURDIR)/debian/tmp/usr/bin/qbzd completions fish \
		> $(CURDIR)/debian/tmp/usr/share/fish/vendor_completions.d/qbzd.fish

override_dh_installsystemd:
	# Both units are user-scope and opt-in (qbzd's own header documents the
	# `loginctl enable-linger` requirement headless boxes need) — never
	# auto-enabled/started at install time.
	dh_installsystemd --no-enable --no-start

override_dh_missing:
	dh_missing --list-missing

.PHONY: override_dh_auto_clean override_dh_clean override_dh_auto_build override_dh_auto_test override_dh_auto_install override_dh_installsystemd override_dh_missing
