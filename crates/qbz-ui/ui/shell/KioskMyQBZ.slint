// KioskMyQBZ — lightweight kiosk My QBZ view (2.0.2 frente #3). Reads the same
// MyQbzState the desktop MixtapesView/CollectionsView read. Tabs Mixtapes /
// Collections (separate ContentView routes); simple cover cards, tap opens the
// detail. Covers are push-only. Mounted for both ContentView.mixtapes and
// ContentView.collections.
//
// Keyboard/gamepad nav (PR 2): the index space is the 2 tabs followed by the
// active list as a 6-column grid. Enter on a tab routes through the same
// header-menu navigation the tab TouchAreas use.
import { Theme } from "../foundation/semantic-colors.slint";
import { Radius } from "../foundation/radius.slint";
import { MyQbzState, MyQbzActions, MixtapeCardItem, NavState, ContentView, KioskNavState } from "../state.slint";

component MyQbzTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    // Keyboard/gamepad nav (PR 2): this tab holds the shell focus ring.
    in property <bool> nav-focused: false;
    callback picked;
    horizontal-stretch: 0;
    border-width: root.nav-focused ? 2px : 0px;
    border-color: Theme.accent;
    border-radius: Radius.sm;
    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        VerticalLayout {
            Text {
                text: root.label;
                color: root.active ? Theme.text-primary : Theme.text-muted;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                height: 2px;
                background: root.active ? Theme.accent : transparent;
                border-radius: 2px;
            }
        }
    }
    ta := TouchArea {
        clicked => {
            root.picked();
        }
    }
}

component MyQbzCardLite inherits Rectangle {
    in property <MixtapeCardItem> item;
    in property <length> size: 150px;
    // Keyboard/gamepad nav (PR 2) — same ring idiom as KioskCard.
    in property <bool> nav-focused: false;
    callback clicked(string);
    width: root.size;
    border-width: root.nav-focused ? 3px : 0px;
    border-color: Theme.accent;
    border-radius: Radius.sm;
    background: root.nav-focused ? Theme.accent.with-alpha(0.12) : transparent;
    VerticalLayout {
        alignment: start;
        spacing: 7px;
        Rectangle {
            width: root.size;
            height: root.size;
            border-radius: Radius.md;
            background: Theme.surface-elevated;
            clip: true;
            if root.item.has-custom-cover: Image {
                width: 100%;
                height: 100%;
                source: root.item.custom-cover;
                image-fit: cover;
            }
            if !root.item.has-custom-cover && root.item.url1 != "": Image {
                width: 100%;
                height: 100%;
                source: root.item.cover1;
                image-fit: cover;
            }
        }
        Text {
            text: root.item.name;
            color: Theme.text-primary;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
            wrap: no-wrap;
        }
        Text {
            text: root.item.label + " · " + root.item.meta;
            color: Theme.text-muted;
            font-size: 12px;
            overflow: elide;
            wrap: no-wrap;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked(root.item.id);
        }
    }
}

export component KioskMyQBZ inherits Rectangle {
    // Tab switch routes through the same header-menu navigation the Sidebar uses.
    callback navigate(string);

    property <length> pad: 16px;
    property <bool> on-collections: NavState.view == ContentView.collections;

    // ---- Nav geometry publish (PR 2): 2 tabs + the active list.
    function publish-nav() {
        KioskNavState.tabs = 2;
        KioskNavState.shelves = false;
        KioskNavState.columns = 6;
        KioskNavState.count = 2 + (root.on-collections
            ? MyQbzState.collections.length
            : MyQbzState.mixtapes.length);
        KioskNavState.index = Math.max(0, Math.min(KioskNavState.index, KioskNavState.count - 1));
    }
    init => {
        root.publish-nav();
    }
    property <int> nav-len-probe: MyQbzState.collections.length + MyQbzState.mixtapes.length;
    changed nav-len-probe => {
        root.publish-nav();
    }

    // Enter on a tab → the same route the tab TouchAreas navigate to.
    property <int> act-probe: KioskNavState.activate-seq;
    changed act-probe => {
        if (KioskNavState.nav-active && KioskNavState.zone == "content"
            && KioskNavState.index < KioskNavState.tabs) {
            if (KioskNavState.index == 0) {
                root.navigate("myqbz-mixtapes");
            } else if (KioskNavState.index == 1) {
                root.navigate("myqbz-collections");
            }
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 48px;
            background: Theme.surface-main;
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                spacing: 22px;
                alignment: start;
                MyQbzTab {
                    label: @tr("Mixtapes");
                    active: !root.on-collections;
                    nav-focused: KioskNavState.nav-active && KioskNavState.zone == "content" && KioskNavState.index == 0;
                    picked => {
                        root.navigate("myqbz-mixtapes");
                    }
                }
                MyQbzTab {
                    label: @tr("Collections");
                    active: root.on-collections;
                    nav-focused: KioskNavState.nav-active && KioskNavState.zone == "content" && KioskNavState.index == 1;
                    picked => {
                        root.navigate("myqbz-collections");
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        content := Rectangle {
            vertical-stretch: 1;
            clip: true;
            grid := Flickable {
                property <int> cols: 6;
                property <length> gap: 16px;
                property <length> cell: (self.width - 2 * root.pad - (self.cols - 1) * self.gap) / self.cols;
                viewport-width: self.width;
                viewport-height: Math.ceil((root.on-collections ? MyQbzState.collections.length : MyQbzState.mixtapes.length) / self.cols) * (self.cell + 44px + self.gap) + root.pad;

                // PR 2 — focus ring + Enter + scroll-into-view.
                property <int> focused-item: KioskNavState.index - KioskNavState.tabs;
                property <bool> item-focused: KioskNavState.nav-active
                    && KioskNavState.zone == "content"
                    && self.focused-item >= 0
                    && self.focused-item < (root.on-collections
                        ? MyQbzState.collections.length
                        : MyQbzState.mixtapes.length);
                property <length> focus-top: root.pad + Math.floor(self.focused-item / self.cols) * (self.cell + 44px + self.gap);
                property <int> nav-index-probe: KioskNavState.index;
                changed nav-index-probe => {
                    if (self.item-focused) {
                        if (self.focus-top < -self.viewport-y) {
                            self.viewport-y = -(self.focus-top - 8px);
                        } else if (self.focus-top + self.cell + 44px > -self.viewport-y + self.height) {
                            self.viewport-y = -(self.focus-top + self.cell + 44px - self.height + 8px);
                        }
                    }
                }
                property <int> act-probe: KioskNavState.activate-seq;
                changed act-probe => {
                    if (self.item-focused) {
                        if (root.on-collections) {
                            MyQbzActions.open-card(MyQbzState.collections[self.focused-item].id);
                        } else {
                            MyQbzActions.open-card(MyQbzState.mixtapes[self.focused-item].id);
                        }
                    }
                }

                Rectangle {
                    for item[i] in (root.on-collections ? MyQbzState.collections : MyQbzState.mixtapes): MyQbzCardLite {
                        x: root.pad + Math.mod(i, grid.cols) * (grid.cell + grid.gap);
                        y: root.pad + Math.floor(i / grid.cols) * (grid.cell + 44px + grid.gap);
                        size: grid.cell;
                        item: item;
                        nav-focused: grid.item-focused && grid.focused-item == i;
                        clicked(id) => {
                            MyQbzActions.open-card(id);
                        }
                    }
                }
            }
        }
    }
}
